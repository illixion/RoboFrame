<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Browse library</title>
    <style>
      /* A contact sheet for the frame's library: every post is shown at its
         true aspect ratio (taken from the DB, so the grid settles before a
         single byte of image arrives) on a dark table, with its numbers
         printed along the bottom edge like film. Safelight amber is the only
         accent; everything else is graphite. */
      :root{
        --bg:#0b0c0e;
        --table:#101216;
        --panel:#14161a;
        --rule:#262a31;
        --rule-soft:#1c1f25;
        --text:#e8eaed;
        --muted:#8b929c;
        --amber:#ffb03a;
        --amber-dim:#7a5518;
        --danger:#ff6b6b;
        --gap:14px;
        --row:2px;
        --edge:26px;
        --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,monospace;
        --ui:system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
      }
      *{box-sizing:border-box}
      html,body{margin:0;background:var(--bg);color:var(--text);font-family:var(--ui);
        -webkit-text-size-adjust:100%}
      button,input{font:inherit;color:inherit}
      :focus-visible{outline:2px solid var(--amber);outline-offset:2px}

      /* ---- masthead ------------------------------------------------------ */
      .masthead{position:sticky;top:0;z-index:50;background:rgba(11,12,14,0.94);
        backdrop-filter:blur(8px);border-bottom:1px solid var(--rule)}
      .masthead .inner{max-width:1900px;margin:0 auto;padding:14px 18px 12px;
        display:flex;flex-wrap:wrap;gap:12px;align-items:center}
      .wordmark{font-family:var(--mono);font-size:12px;letter-spacing:.34em;
        text-transform:uppercase;color:var(--muted);white-space:nowrap}
      .wordmark b{color:var(--amber);font-weight:600}

      .query{flex:1 1 300px;min-width:220px;display:flex;align-items:center;gap:10px;
        background:var(--panel);border:1px solid var(--rule);border-radius:2px;
        padding:0 10px;height:40px}
      .query:focus-within{border-color:var(--amber-dim)}
      .query .sigil{font-family:var(--mono);color:var(--amber);font-size:13px;user-select:none}
      .query input{flex:1;background:none;border:0;outline:none;font-family:var(--mono);
        font-size:14px;letter-spacing:.01em;min-width:0}
      .query input::placeholder{color:#5d646e}

      .tool{height:40px;padding:0 14px;background:transparent;border:1px solid var(--rule);
        border-radius:2px;font-family:var(--mono);font-size:11px;letter-spacing:.14em;
        text-transform:uppercase;color:var(--muted);cursor:pointer;white-space:nowrap}
      .tool:hover{color:var(--text);border-color:#3b414b}
      .tool.primary{background:var(--amber);border-color:var(--amber);color:#160d00;font-weight:700}
      .tool.primary:hover{background:#ffbe5c}

      /* Tag-list presets. The <select> stays native — its popup is the one
         widget that can spill past the masthead and show a long list of tags
         on one line without a scroll trap of our own making. */
      .preset{position:relative;display:none}
      .preset.ready{display:block}
      /* Lowercase and unspaced, unlike its sibling buttons: the closed control
         shows the head of an actual query, and a query is typed as it reads. */
      .preset select{appearance:none;max-width:210px;padding-right:32px;
        font-size:12px;letter-spacing:0;text-transform:none;
        text-overflow:ellipsis;background:var(--panel)}
      .preset select option{font-family:var(--mono);background:var(--panel);color:var(--text)}
      .preset::after{content:"";position:absolute;right:13px;top:50%;
        margin-top:-2px;border:4px solid transparent;border-top-color:var(--muted);
        pointer-events:none}

      /* Sheet position: a hairline that fills as you walk deeper into the deck. */
      .position{height:2px;background:var(--rule-soft)}
      .position i{display:block;height:100%;width:0;background:var(--amber);
        transition:width .25s ease}

      /* ---- status line --------------------------------------------------- */
      .status{max-width:1900px;margin:0 auto;padding:14px 18px 4px;
        display:flex;flex-wrap:wrap;gap:6px 18px;align-items:baseline;
        font-family:var(--mono);font-size:11px;letter-spacing:.16em;
        text-transform:uppercase;color:var(--muted)}
      .status .count{color:var(--text)}
      .status .hint{text-transform:none;letter-spacing:.02em}
      /* Sibling page, carrying the same token so the link lands authenticated. */
      .status a{margin-left:auto;color:var(--muted);text-decoration:none;
        border-bottom:1px solid var(--rule)}
      .status a:hover{color:var(--amber);border-bottom-color:var(--amber-dim)}

      .syntax{max-width:1900px;margin:0 auto;padding:0 18px}
      .syntax dl{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
        gap:2px 22px;margin:12px 0 0;padding:14px 16px;background:var(--panel);
        border:1px solid var(--rule);border-radius:2px;font-size:13px}
      .syntax dl[hidden]{display:none}
      .syntax div{display:flex;gap:10px;padding:3px 0;align-items:baseline}
      .syntax dt{font-family:var(--mono);color:var(--amber);white-space:nowrap}
      .syntax dd{margin:0;color:var(--muted)}

      /* ---- the sheet ----------------------------------------------------- */
      .sheet{max-width:1900px;margin:0 auto;padding:18px}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
        grid-auto-rows:var(--row);gap:var(--gap)}
      @media (max-width:640px){
        .grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
      }

      /* align-self:start keeps a tile at its natural height — the row span only
         reserves space, so the border hugs the frame instead of trailing the
         rounding slack below the edge print. */
      .tile{position:relative;align-self:start;background:var(--table);
        border:1px solid var(--rule-soft);
        border-radius:2px;overflow:hidden;cursor:zoom-in;
        transition:border-color .16s ease,transform .16s ease}
      .tile:hover{border-color:#3b414b;transform:translateY(-2px)}
      .tile.selected{border-color:var(--amber)}
      .frame{position:relative;aspect-ratio:var(--ar,1);background:#080909;overflow:hidden}
      .frame img,.frame video{position:absolute;inset:0;width:100%;height:100%;
        object-fit:cover;opacity:0;transition:opacity .35s ease}
      .frame img.shown,.frame video.shown{opacity:1}
      .frame .pending{position:absolute;inset:0;display:flex;align-items:center;
        justify-content:center;font-family:var(--mono);font-size:10px;letter-spacing:.2em;
        color:#3f454e}
      .frame .pending.failed{color:var(--danger)}

      /* Film-edge print: the tile's identity, always legible, never in the way. */
      .edge{height:var(--edge);display:flex;align-items:center;gap:8px;padding:0 8px;
        font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;color:var(--muted);
        border-top:1px solid var(--rule-soft);white-space:nowrap;overflow:hidden}
      .edge .no{color:var(--amber);letter-spacing:.1em}
      .edge .dim{overflow:hidden;text-overflow:ellipsis}
      .edge .flag{margin-left:auto;padding:1px 5px;border:1px solid var(--rule);
        border-radius:2px;font-size:9.5px;letter-spacing:.1em;color:var(--muted)}

      .empty,.failure{padding:80px 18px;text-align:center;color:var(--muted)}
      .empty code,.failure code{font-family:var(--mono);color:var(--amber)}
      .more{padding:26px 18px 60px;display:flex;flex-direction:column;align-items:center;
        gap:12px;font-family:var(--mono);font-size:11px;letter-spacing:.2em;
        text-transform:uppercase;color:#4c525b}

      /* ---- viewer -------------------------------------------------------- */
      .viewer{position:fixed;inset:0;z-index:100;background:rgba(6,7,8,0.97);
        display:none;grid-template-columns:1fr 300px}
      .viewer.open{display:grid}
      @media (max-width:820px){
        .viewer.open{grid-template-columns:1fr;grid-template-rows:1fr auto}
      }
      /* zoom-out on the empty part of the stage: the bare backdrop dismisses. */
      .stage{position:relative;display:flex;align-items:center;justify-content:center;
        min-height:0;padding:14px;cursor:zoom-out}
      .stage img,.stage video,.stage .step{cursor:default}
      .stage .step{cursor:pointer}
      .stage img,.stage video{max-width:100%;max-height:100%;object-fit:contain}
      .stage [hidden]{display:none}
      .step{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:64px;
        background:rgba(0,0,0,0.5);border:1px solid var(--rule);border-radius:2px;
        color:var(--text);font-size:20px;cursor:pointer}
      .step:hover{background:rgba(0,0,0,0.8);border-color:var(--amber-dim)}
      .step.prev{left:10px}
      .step.next{right:10px}

      .rail{border-left:1px solid var(--rule);background:var(--panel);padding:16px;
        overflow-y:auto;display:flex;flex-direction:column;gap:16px}
      @media (max-width:820px){.rail{border-left:0;border-top:1px solid var(--rule);max-height:45vh}}
      .rail h2{margin:0;font-family:var(--mono);font-size:13px;letter-spacing:.22em;
        color:var(--amber);font-weight:600}
      .facts{display:grid;grid-template-columns:auto 1fr;gap:5px 14px;
        font-family:var(--mono);font-size:12px}
      .facts dt{color:#6b727c;letter-spacing:.1em;text-transform:uppercase;font-size:10px;
        align-self:center}
      .facts dd{margin:0;color:var(--text)}
      .tags{display:flex;flex-wrap:wrap;gap:5px}
      .tag{background:transparent;border:1px solid var(--rule);border-radius:2px;
        padding:3px 7px;font-family:var(--mono);font-size:11px;color:var(--muted);cursor:pointer}
      .tag:hover{color:var(--amber);border-color:var(--amber-dim)}
      /* Which bytes the stage is actually showing — the source file or the
         server's JPEG/mp4 stand-in. */
      .source{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:#6b727c}
      .source b{color:var(--amber);font-weight:600}
      .rail .acts{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}
      /* The download link is a button in every way except being an <a>. */
      .rail a.tool{display:flex;align-items:center;justify-content:center;
        text-decoration:none}
      .rail .tool{flex:1 1 auto;text-align:center}
      .rail .tool.danger:hover{color:var(--danger);border-color:var(--danger)}
      .said{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--amber);
        min-height:14px}

      @media (prefers-reduced-motion:reduce){
        *{transition:none!important}
      }
    </style>
  </head>
  <body>
    <header class="masthead">
      <div class="inner">
        <div class="wordmark">Robo<b>Frame</b> · Library</div>
        <form class="query" id="queryForm">
          <span class="sigil" aria-hidden="true">&gt;</span>
          <input id="q" name="q" type="text" spellcheck="false" autocomplete="off"
                 aria-label="Search query"
                 placeholder="tag  -tag  ~tag  rating:s  score:>=50  order:id" />
        </form>
        <button class="tool primary" id="run" type="submit" form="queryForm">Search</button>
        <span class="preset" id="presetWrap">
          <select class="tool" id="presets" aria-label="Tag list presets">
            <option value="">Tag lists</option>
          </select>
        </span>
        <button class="tool" id="jump" type="button" title="Start from a random point in the deck">Random window</button>
        <button class="tool" id="help" type="button" aria-expanded="false" aria-controls="syntax">Syntax</button>
      </div>
      <div class="position"><i id="position"></i></div>
    </header>

    <div class="status">
      <span class="count" id="count">Loading library…</span>
      <span class="hint" id="hint"></span>
      <a href="history?token=<%= encodeURIComponent(token || '') %><%= Number(lowmem) === 1 ? '&lowmem=1' : '' %>">Recent requests &rarr;</a>
    </div>

    <div class="syntax">
      <dl id="syntax" hidden>
        <div><dt>tag</dt><dd>must match</dd></div>
        <div><dt>-tag</dt><dd>must not match</dd></div>
        <div><dt>~tag</dt><dd>at least one of these matches</dd></div>
        <div><dt>rating:s</dt><dd>exact rating</dd></div>
        <div><dt>file_ext:jxl</dt><dd>exact file type</dd></div>
        <div><dt>score:&gt;=50</dt><dd>&lt; &lt;= &gt; &gt;= != on numbers</dd></div>
        <div><dt>ratio:1.7..1.8</dt><dd>numeric range</dd></div>
        <div><dt>image_width:&gt;=2000</dt><dd>pixel dimensions</dd></div>
        <div><dt>order:id</dt><dd>id, score, score_asc, random</dd></div>
        <div><dt>limit:80</dt><dd>frames per page</dd></div>
      </dl>
    </div>

    <main class="sheet">
      <div class="grid" id="grid"></div>
      <div class="more" id="more"></div>
    </main>

    <div class="viewer" id="viewer" aria-hidden="true" role="dialog" aria-label="Frame detail">
      <div class="stage">
        <img id="stageImg" alt="" />
        <video id="stageVideo" playsinline controls loop hidden></video>
        <button class="step prev" id="stepPrev" type="button" aria-label="Previous frame">&#8249;</button>
        <button class="step next" id="stepNext" type="button" aria-label="Next frame">&#8250;</button>
      </div>
      <aside class="rail">
        <h2 id="railId">—</h2>
        <dl class="facts" id="facts"></dl>
        <div class="source" id="source"></div>
        <div class="tags" id="tags"></div>
        <div class="said" id="said"></div>
        <div class="acts">
          <a class="tool" id="actDownload" download>Download</a>
          <button class="tool" id="actSave" type="button">Save</button>
          <button class="tool danger" id="actBlock" type="button">Block</button>
          <button class="tool" id="actClose" type="button">Close</button>
        </div>
      </aside>
    </div>

    <script>
      const TOKEN = <%- JSON.stringify(token || '') %>;
      const LOWMEM = <%- JSON.stringify(Number(lowmem) === 1 ? 1 : 0) %>;
      const PAGE = <%- JSON.stringify(Number(pageSize) || 60) %>;
      const tokenParam = TOKEN ? '&token=' + encodeURIComponent(TOKEN) : '';
      // Resolve sibling endpoints relative to this page so a reverse-proxy
      // subpath (e.g. /myslideshow/browse) keeps working.
      const BASE = new URL('./', window.location.href);
      const endpoint = (name, query) => new URL(name + '?' + query, BASE).toString();

      const ROW = 2, GAP = 14, EDGE = 26;
      const VIDEO_EXT = /^(webm|mp4|mkv|mov|m4v)$/i;

      const grid = document.getElementById('grid');
      const input = document.getElementById('q');
      const countEl = document.getElementById('count');
      const hintEl = document.getElementById('hint');
      const moreEl = document.getElementById('more');
      const positionEl = document.getElementById('position');

      // One search run: the posts fetched so far plus where the server said to
      // continue from. `token` guards against a stale page landing after the
      // query changed.
      let run = {
        token: 0, posts: [], seen: new Set(), cursor: null,
        done: false, loading: false, failed: false, total: null,
      };

      // How close to the end of the page counts as "asking for more".
      const REACH = 900;

      // ---- URL <-> query --------------------------------------------------
      const queryFromUrl = () => new URLSearchParams(location.search).get('q') || '';
      function pushQuery(q) {
        const params = new URLSearchParams(location.search);
        if (q) params.set('q', q); else params.delete('q');
        history.replaceState(null, '', location.pathname + (params.toString() ? '?' + params : ''));
      }

      // ---- media URLs -----------------------------------------------------
      const thumbUrl = (post) => endpoint('get', 'id=' + post.id
        + '&convert=1&bright=0&width=640&height=640&record=0&lowmem=' + LOWMEM + tokenParam);
      const fullUrl = (post) => endpoint('get', 'id=' + post.id
        + '&convert=1&bright=0&record=0&lowmem=' + LOWMEM + tokenParam);
      // The untouched source bytes. `rawanimated=1` keeps the server from
      // converting an animated post to WebP/mp4 on the way out, so this is the
      // real file for every post — what a browser with its own JXL decoder
      // should get, and what the download button hands over.
      const rawUrl = (post) => endpoint('get', 'id=' + post.id
        + '&rawanimated=1&record=0' + tokenParam);
      // Video posts bypass the image pipeline: /get streams the file with Range
      // support, so a metadata-only preload pulls just the head.
      const streamUrl = (post) => endpoint('get', 'id=' + post.id + '&record=0' + tokenParam);

      // ---- fetching -------------------------------------------------------
      // The server's random-order cursor is a (display_count, random_rank)
      // pair; deterministic orders page by row offset.
      const encodeCursor = (c) => (c && Number.isFinite(c.rank))
        ? c.dc + ',' + c.rank
        : String(c && c.offset || 0);

      function normalize(row) {
        const w = Number(row.image_width) || 0;
        const h = Number(row.image_height) || 0;
        const ratio = w && h ? w / h : (Number(row.ratio) || 1);
        return {
          id: String(row._id),
          ext: String(row.file_ext || ''),
          w, h, ratio,
          rating: row.rating || '',
          score: Number(row.score) || 0,
          favCount: Number(row.fav_count) || 0,
          duration: Number(row.duration) || 0,
          tags: Array.isArray(row.tags) ? row.tags : [],
        };
      }

      async function loadPage() {
        if (run.loading || run.done) return;
        run.loading = true;
        run.failed = false;
        const token = run.token;
        report();
        const parts = ['q=' + encodeURIComponent(input.value.trim()), 'limit=' + PAGE];
        if (run.cursor) parts.push('cursor=' + encodeURIComponent(encodeCursor(run.cursor)));
        try {
          const resp = await fetch(endpoint('search', parts.join('&') + tokenParam));
          if (!resp.ok) throw new Error('search ' + resp.status);
          const data = await resp.json();
          if (token !== run.token) return;
          const page = (data.results || []).map(normalize);
          // The deck's paging key is (display_count, random_rank), and
          // display_count moves under us — every frame the displays advance
          // bumps a post into a higher tier, i.e. back ahead of our cursor. A
          // wrapped last page tops itself up from the deck's head for the same
          // reason. Both hand back rows we already have, so the sheet keeps its
          // own set and shows each post once.
          const posts = page.filter((post) => !run.seen.has(post.id));
          posts.forEach((post) => run.seen.add(post.id));
          run.posts.push.apply(run.posts, posts);
          run.cursor = data.nextCursor || null;
          run.done = !run.cursor || page.length === 0;
          posts.forEach(addTile);
          layout();
        } catch (err) {
          if (token !== run.token) return;
          console.error(err);
          // A failed page leaves the run resumable: the cursor is untouched, so
          // Load more retries the same page rather than skipping it.
          run.failed = true;
          if (!run.posts.length) {
            grid.innerHTML = '';
            const p = document.createElement('p');
            p.className = 'failure';
            p.textContent = 'Search failed. Check the query syntax, then run it again.';
            grid.after(p);
          }
        } finally {
          if (token === run.token) {
            run.loading = false;
            report();
            // A page whose tiles don't reach past the fold has to pull the next
            // one itself — waiting for a scroll that never comes is how the
            // sheet used to stall on its first page.
            if (!run.failed) setTimeout(maybeLoadMore, 0);
          }
        }
      }

      // Paging trigger. Deliberately a measurement rather than an
      // IntersectionObserver on a sentinel: an observer only reports *changes*,
      // so a sentinel that was already in view when a page landed never fires
      // again and paging dies until something else calls loadPage.
      function nearEnd() {
        const doc = document.documentElement;
        return doc.scrollHeight - (window.scrollY + window.innerHeight) < REACH;
      }

      function maybeLoadMore() {
        if (run.loading || run.done || run.failed) return;
        if (nearEnd()) loadPage();
      }

      async function loadCount() {
        const token = run.token;
        try {
          const resp = await fetch(endpoint('count', 'q=' + encodeURIComponent(input.value.trim()) + tokenParam));
          if (!resp.ok) return;
          const data = await resp.json();
          if (token !== run.token) return;
          run.total = Number(data.count) || 0;
          report();
        } catch (_) { /* count is a nicety; the grid stands without it */ }
      }

      function report() {
        const shown = run.posts.length;
        if (run.total === null) {
          countEl.textContent = shown + (shown === 1 ? ' frame' : ' frames');
        } else {
          countEl.textContent = shown.toLocaleString() + ' of ' + run.total.toLocaleString()
            + (run.total === 1 ? ' frame' : ' frames');
        }
        positionEl.style.width = run.total
          ? Math.min(100, (shown / run.total) * 100) + '%'
          : '0';
        renderMore();
        if (!shown && run.done) showEmpty();
      }

      // The tail of the sheet: a status word while paging runs by itself, and a
      // button whenever there's a page left to fetch — the way out when the
      // automatic trigger doesn't fire on a given browser, and the retry after
      // a failed page.
      function renderMore() {
        moreEl.innerHTML = '';
        if (run.loading) {
          moreEl.append(note('Loading…'));
          return;
        }
        if (run.done) {
          if (run.posts.length) moreEl.append(note('End of deck'));
          return;
        }
        if (run.failed) moreEl.append(note('That page didn’t load.'));
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'tool';
        button.textContent = run.failed ? 'Try again' : 'Load more';
        button.addEventListener('click', loadPage);
        moreEl.append(button);
      }

      function note(text) {
        const span = document.createElement('span');
        span.className = 'word';
        span.textContent = text;
        return span;
      }

      function showEmpty() {
        const p = document.createElement('p');
        p.className = 'empty';
        p.innerHTML = 'Nothing matches that query. Try <code>rating:s</code> or clear the box to see the whole library.';
        grid.after(p);
      }

      // ---- tiles ----------------------------------------------------------
      function addTile(post) {
        const tile = document.createElement('article');
        tile.className = 'tile';
        tile.dataset.id = post.id;
        tile.style.setProperty('--ar', post.ratio.toFixed(4));

        const frame = document.createElement('div');
        frame.className = 'frame';
        const pending = document.createElement('div');
        pending.className = 'pending';
        pending.textContent = '· · ·';
        frame.appendChild(pending);

        const edge = document.createElement('div');
        edge.className = 'edge';
        const no = document.createElement('span');
        no.className = 'no';
        no.textContent = '#' + post.id;
        const dim = document.createElement('span');
        dim.className = 'dim';
        dim.textContent = post.w && post.h ? post.w + '×' + post.h : post.ext.toUpperCase();
        edge.append(no, dim);
        if (VIDEO_EXT.test(post.ext)) {
          const flag = document.createElement('span');
          flag.className = 'flag';
          flag.textContent = post.duration ? formatDuration(post.duration) : 'VIDEO';
          edge.appendChild(flag);
        }

        tile.append(frame, edge);
        tile.addEventListener('click', () => openViewer(post.id));
        grid.appendChild(tile);
        watcher.observe(tile);
      }

      const formatDuration = (secs) => {
        const s = Math.round(secs);
        return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
      };

      // Row spans from the known aspect ratio, so the sheet is laid out before
      // any image loads and never shifts under the reader.
      function layout() {
        const first = grid.querySelector('.tile');
        if (!first) return;
        const colWidth = first.getBoundingClientRect().width;
        if (!colWidth) return;
        for (const tile of grid.children) {
          const ar = Number(tile.style.getPropertyValue('--ar')) || 1;
          const height = colWidth / ar + EDGE + 2;
          tile.style.gridRowEnd = 'span ' + Math.max(1, Math.ceil((height + GAP) / (ROW + GAP)));
        }
      }
      window.addEventListener('resize', () => { layout(); maybeLoadMore(); });

      // ---- lazy media, at most four fetches in flight ---------------------
      // Animated posts come back from /get as mp4 (the kiosk pipeline's
      // animated variant), so the fetched MIME type — not the post's ext —
      // decides which element renders it.
      const queue = [];
      let inFlight = 0;

      const watcher = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          watcher.unobserve(entry.target);
          queue.push(entry.target);
        }
        pump();
      }, { rootMargin: '600px 0px' });

      function pump() {
        while (inFlight < 4 && queue.length) {
          const tile = queue.shift();
          inFlight++;
          renderMedia(tile).finally(() => { inFlight--; pump(); });
        }
      }

      function byId(id) { return run.posts.find((p) => p.id === id); }

      async function renderMedia(tile) {
        const post = byId(tile.dataset.id);
        const frame = tile.querySelector('.frame');
        const pending = frame.querySelector('.pending');
        const fail = () => { if (pending) { pending.textContent = 'no preview'; pending.classList.add('failed'); } };

        if (VIDEO_EXT.test(post.ext)) {
          // Seek a metadata-only <video> to its first frame: enough of a poster
          // without pulling the clip.
          const video = document.createElement('video');
          video.muted = true; video.playsInline = true; video.preload = 'metadata';
          const reveal = () => { video.classList.add('shown'); if (pending) pending.remove(); };
          video.onloadedmetadata = () => { try { video.currentTime = 0.1; } catch (_) {} };
          video.onloadeddata = reveal;
          video.onseeked = reveal;
          video.onerror = fail;
          video.src = streamUrl(post);
          frame.appendChild(video);
          return;
        }

        try {
          const resp = await fetch(thumbUrl(post));
          if (!resp.ok) throw new Error('thumb ' + resp.status);
          const blob = await resp.blob();
          const url = URL.createObjectURL(blob);
          if (blob.type.startsWith('video/')) {
            const video = document.createElement('video');
            video.muted = true; video.loop = true; video.playsInline = true; video.autoplay = true;
            video.onloadeddata = () => { video.classList.add('shown'); if (pending) pending.remove(); };
            video.onerror = fail;
            video.src = url;
            frame.appendChild(video);
          } else {
            const img = document.createElement('img');
            img.alt = 'Frame ' + post.id;
            img.decoding = 'async';
            img.onload = () => { img.classList.add('shown'); if (pending) pending.remove(); };
            img.onerror = fail;
            img.src = url;
            frame.appendChild(img);
          }
        } catch (err) {
          fail();
        }
      }

      // ---- viewer ---------------------------------------------------------
      const viewer = document.getElementById('viewer');
      const stageImg = document.getElementById('stageImg');
      const stageVideo = document.getElementById('stageVideo');
      const railId = document.getElementById('railId');
      const facts = document.getElementById('facts');
      const tagsEl = document.getElementById('tags');
      const sourceEl = document.getElementById('source');
      const said = document.getElementById('said');
      let openId = null;

      function fact(label, value) {
        const dt = document.createElement('dt');
        dt.textContent = label;
        const dd = document.createElement('dd');
        dd.textContent = value;
        facts.append(dt, dd);
      }

      function openViewer(id) {
        const post = byId(id);
        if (!post) return;
        openId = id;
        said.textContent = '';
        railId.textContent = '#' + post.id;
        grid.querySelectorAll('.tile.selected').forEach((t) => t.classList.remove('selected'));
        const tile = grid.querySelector('.tile[data-id="' + CSS.escape(id) + '"]');
        if (tile) tile.classList.add('selected');

        facts.innerHTML = '';
        if (post.w && post.h) fact('Size', post.w + ' × ' + post.h);
        fact('Ratio', post.ratio.toFixed(3));
        fact('Type', post.ext.toUpperCase() || '—');
        if (post.rating) fact('Rating', post.rating);
        fact('Score', post.score.toLocaleString());
        if (post.favCount) fact('Favorites', post.favCount.toLocaleString());
        if (post.duration) fact('Length', formatDuration(post.duration));

        tagsEl.innerHTML = '';
        post.tags.slice(0, 60).forEach((tag) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'tag';
          b.textContent = tag;
          b.title = 'Search this tag';
          b.addEventListener('click', () => { input.value = tag; closeViewer(); search(); });
          tagsEl.appendChild(b);
        });

        const download = document.getElementById('actDownload');
        download.href = rawUrl(post);
        download.setAttribute('download', post.id + (post.ext ? '.' + post.ext : ''));
        download.title = 'Save the original ' + (post.ext ? '.' + post.ext + ' ' : '') + 'file';

        showOnStage(post);
        viewer.classList.add('open');
        viewer.setAttribute('aria-hidden', 'false');
      }

      // Stage loading. The source file goes to the browser first: a browser that
      // decodes JXL (or AVIF, or whatever the library holds) shows the real
      // pixels and the server never runs djxl. Only a decode failure falls back
      // to the converted variant — which is also the path that carries animated
      // posts, since those come back as mp4 rather than an image.
      let stageGeneration = 0;

      function showOnStage(post) {
        const generation = ++stageGeneration;
        clearStage();
        if (VIDEO_EXT.test(post.ext)) {
          stageVideo.hidden = false;
          stageVideo.src = streamUrl(post);
          stageVideo.play().catch(() => {});
          setSource('Streaming the source', post.ext);
          return;
        }
        stageImg.hidden = false;
        stageImg.alt = 'Frame ' + post.id;
        setSource('Loading…', '');
        stageImg.onload = () => {
          if (generation !== stageGeneration) return;
          setSource('Showing the source', post.ext);
        };
        stageImg.onerror = () => {
          if (generation !== stageGeneration) return;
          showConverted(post, generation);
        };
        stageImg.src = rawUrl(post);
      }

      async function showConverted(post, generation) {
        setSource('Converting…', '');
        let blob;
        try {
          const resp = await fetch(fullUrl(post));
          if (!resp.ok) throw new Error('convert ' + resp.status);
          blob = await resp.blob();
        } catch (err) {
          console.error(err);
          if (generation === stageGeneration) setSource('This frame wouldn’t load', '');
          return;
        }
        if (generation !== stageGeneration) return;
        const url = URL.createObjectURL(blob);
        // An animated post converts to mp4, so the response type — not the
        // post's ext — decides the element.
        if (blob.type.startsWith('video/')) {
          stageImg.hidden = true;
          stageImg.onload = stageImg.onerror = null;
          stageImg.removeAttribute('src');
          stageVideo.hidden = false;
          stageVideo.muted = true;
          stageVideo.src = url;
          stageVideo.play().catch(() => {});
          setSource('Showing a converted copy', blob.type.split('/')[1] || '');
        } else {
          const kind = blob.type.split('/')[1] || '';
          // Replace the raw attempt's handlers — its onload would otherwise fire
          // for these bytes and label the converted copy as the source.
          stageImg.onload = () => {
            if (generation === stageGeneration) setSource('Showing a converted copy', kind);
          };
          stageImg.onerror = () => {
            if (generation === stageGeneration) setSource('This frame wouldn’t load', '');
          };
          stageImg.src = url;
        }
      }

      function setSource(text, ext) {
        sourceEl.textContent = text;
        if (!ext) return;
        sourceEl.append(' · ');
        const b = document.createElement('b');
        b.textContent = ext.toUpperCase();
        sourceEl.append(b);
      }

      function clearStage() {
        stageImg.onload = stageImg.onerror = null;
        stageImg.hidden = true;
        stageImg.removeAttribute('src');
        stageVideo.hidden = true;
        stageVideo.pause();
        stageVideo.muted = false;
        stageVideo.removeAttribute('src');
        stageVideo.load();
      }

      function closeViewer() {
        openId = null;
        stageGeneration++;
        viewer.classList.remove('open');
        viewer.setAttribute('aria-hidden', 'true');
        clearStage();
      }

      function step(delta) {
        if (openId === null) return;
        const i = run.posts.findIndex((p) => p.id === openId);
        const next = run.posts[i + delta];
        if (next) {
          openViewer(next.id);
          const tile = grid.querySelector('.tile[data-id="' + CSS.escape(next.id) + '"]');
          if (tile) tile.scrollIntoView({ block: 'nearest' });
          return;
        }
        // Walked off the end of what's loaded: fetch the next page and carry on
        // into it, so stepping never dead-ends mid-deck.
        if (delta > 0 && !run.done) {
          const from = openId;
          loadPage().then(() => { if (openId === from) step(1); });
        }
      }

      async function act(button, label, url, done) {
        button.disabled = true;
        const original = button.textContent;
        button.textContent = label;
        try {
          const resp = await fetch(url);
          if (!resp.ok) throw new Error(String(resp.status));
          done();
        } catch (err) {
          console.error(err);
          said.textContent = original + ' failed';
        } finally {
          button.textContent = original;
          button.disabled = false;
        }
      }

      document.getElementById('actSave').addEventListener('click', (ev) => {
        if (openId === null) return;
        const id = openId;
        act(ev.currentTarget, 'Saving…', endpoint('save', 'id=' + id + tokenParam),
          () => { said.textContent = 'Saved #' + id; });
      });

      document.getElementById('actBlock').addEventListener('click', (ev) => {
        if (openId === null) return;
        const id = openId;
        act(ev.currentTarget, 'Blocking…', endpoint('block', 'id=' + id + tokenParam), () => {
          // Blocked server-side: the frames stop serving it, so drop it here too.
          run.posts = run.posts.filter((p) => p.id !== id);
          const tile = grid.querySelector('.tile[data-id="' + CSS.escape(id) + '"]');
          if (tile) tile.remove();
          layout();
          report();
          closeViewer();
        });
      });

      // Backdrop dismissal: only the stage's own empty area, so a click on the
      // frame itself, on a video's controls, or on a step arrow stays put.
      document.querySelector('.stage').addEventListener('click', (ev) => {
        if (ev.target === ev.currentTarget) closeViewer();
      });

      document.getElementById('actClose').addEventListener('click', closeViewer);
      document.getElementById('stepPrev').addEventListener('click', () => step(-1));
      document.getElementById('stepNext').addEventListener('click', () => step(1));

      // ---- searching ------------------------------------------------------
      function search(startCursor) {
        run.token++;
        run = {
          token: run.token, posts: [], seen: new Set(), cursor: startCursor || null,
          done: false, loading: false, failed: false, total: null,
        };
        queue.length = 0;
        grid.innerHTML = '';
        document.querySelectorAll('.empty,.failure').forEach((n) => n.remove());
        countEl.textContent = 'Searching…';
        positionEl.style.width = '0';
        pushQuery(input.value.trim());
        syncPreset();
        loadCount();
        loadPage();
      }

      document.getElementById('queryForm').addEventListener('submit', (ev) => {
        ev.preventDefault();
        input.blur();
        search();
      });

      // The deck order is fixed for the life of the server, so "random window"
      // means starting from an arbitrary point in it rather than reshuffling.
      document.getElementById('jump').addEventListener('click', () => {
        search({ dc: 0, rank: Math.random() });
      });

      // ---- tag-list presets -----------------------------------------------
      // The server-side tag lists the frames cycle through (data.json's
      // `tagLists`, as the kiosks read them off the WS `tagLists` frame). Each
      // one drops into the query box verbatim, so a preset is a starting point
      // to edit rather than a mode to be in — hence the reset back to the
      // placeholder as soon as the query diverges.
      const presetWrap = document.getElementById('presetWrap');
      const presets = document.getElementById('presets');

      async function loadPresets() {
        let lists;
        try {
          const resp = await fetch(endpoint('rpc/tags.json', tokenParam.slice(1)));
          if (!resp.ok) throw new Error('tags ' + resp.status);
          lists = await resp.json();
        } catch (err) {
          console.error(err);
          return;
        }
        const queries = (Array.isArray(lists) ? lists : [])
          .map((list) => (Array.isArray(list) ? list : String(list || '').split(/\s+/)))
          .map((list) => list.filter(Boolean).join(' '))
          .filter(Boolean);
        // No lists configured: leave the control out rather than offer an
        // empty menu.
        if (!queries.length) return;
        queries.forEach((query, i) => {
          const option = document.createElement('option');
          option.value = query;
          option.textContent = (i + 1) + ' · ' + query;
          // The closed control only has room for the head of the query; the
          // tooltip carries the rest.
          option.title = query;
          presets.appendChild(option);
        });
        presetWrap.classList.add('ready');
        syncPreset();
      }

      // Show the preset as selected only while the query still matches it.
      function syncPreset() {
        if (!presetWrap.classList.contains('ready')) return;
        const current = input.value.trim();
        presets.value = Array.prototype.some.call(presets.options, (o) => o.value === current)
          ? current
          : '';
        presets.title = presets.value || 'Search a tag list the frames use';
      }

      presets.addEventListener('change', () => {
        if (!presets.value) return;
        input.value = presets.value;
        search();
      });
      input.addEventListener('input', syncPreset);

      const helpBtn = document.getElementById('help');
      const syntaxEl = document.getElementById('syntax');
      helpBtn.addEventListener('click', () => {
        const open = syntaxEl.hidden;
        syntaxEl.hidden = !open;
        helpBtn.setAttribute('aria-expanded', String(open));
      });

      // Throttled with a timer rather than requestAnimationFrame: rAF is paused
      // in a background tab, and a tab that comes back to a half-scrolled sheet
      // should still page.
      let scrollPending = false;
      window.addEventListener('scroll', () => {
        if (scrollPending) return;
        scrollPending = true;
        setTimeout(() => { scrollPending = false; maybeLoadMore(); }, 60);
      }, { passive: true });

      window.addEventListener('keydown', (ev) => {
        const typing = ev.target === input;
        if (ev.key === '/' && !typing) { ev.preventDefault(); input.focus(); input.select(); return; }
        if (openId === null) return;
        if (ev.key === 'Escape') { closeViewer(); }
        else if (ev.key === 'ArrowRight' || ev.key === 'ArrowDown') { ev.preventDefault(); step(1); }
        else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowUp') { ev.preventDefault(); step(-1); }
      });

      hintEl.innerHTML = 'Press <code>/</code> to search · click a frame for detail · arrows walk the sheet';
      input.value = queryFromUrl();
      loadPresets();
      search();
    </script>
  </body>
</html>
